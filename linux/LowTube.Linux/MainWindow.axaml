<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LowTube.Linux.MainWindow"
        Title="LowTube" Width="1100" Height="720" MinWidth="700" MinHeight="480">
  <Grid RowDefinitions="Auto,*" ColumnDefinitions="220,*">
    <Border Grid.Row="0" Grid.ColumnSpan="2" Padding="18,12" Background="#20232A">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
        <TextBlock Text="LowTube" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="White" />
        <TextBox Grid.Column="1" x:Name="SearchBox" Watermark="Search YouTube or paste a video, playlist, or channel link" VerticalAlignment="Center" />
        <Button Grid.Column="2" x:Name="SearchButton" Content="Search" MinWidth="96" Click="Search_OnClick" />
        <Button Grid.Column="3" x:Name="SettingsButton" Content="Settings" Click="Settings_OnClick" />
      </Grid>
    </Border>
    <Border Grid.Row="1" Grid.Column="0" Background="#F1F2F4" Padding="14">
      <StackPanel Spacing="8">
        <TextBlock x:Name="LibraryLabel" Text="LIBRARY" FontSize="11" FontWeight="Bold" Foreground="#69717D" Margin="8,12,0,4" />
        <Button x:Name="SearchNavButton" Content="Search" HorizontalContentAlignment="Left" Click="Search_OnClick" />
        <Button x:Name="SubscriptionsButton" Content="Subscriptions" HorizontalContentAlignment="Left" Click="Subscriptions_OnClick" />
        <Button x:Name="SavedButton" Content="Saved" HorizontalContentAlignment="Left" Click="Saved_OnClick" />
        <Button x:Name="PlaylistsButton" Content="Playlists" HorizontalContentAlignment="Left" Click="Playlists_OnClick" />
        <Button x:Name="HistoryButton" Content="History" HorizontalContentAlignment="Left" Click="History_OnClick" />
        <Button x:Name="QueueButton" Content="Queue" HorizontalContentAlignment="Left" Click="Queue_OnClick" />
        <Button x:Name="PlayQueueButton" Content="Play queue" HorizontalContentAlignment="Left" Click="PlayQueue_OnClick" />
        <Button x:Name="ClearQueueButton" Content="Clear queue" HorizontalContentAlignment="Left" Click="ClearQueue_OnClick" />
        <Button x:Name="DownloadsButton" Content="Downloads" HorizontalContentAlignment="Left" Click="Downloads_OnClick" />
        <TextBlock x:Name="PortStatusText" Text="Linux port in progress" TextWrapping="Wrap" Foreground="#69717D" Margin="8,20,8,0" />
      </StackPanel>
    </Border>
    <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*,Auto,Auto" Margin="22">
      <StackPanel Spacing="4" Margin="0,0,0,14">
        <TextBlock x:Name="PageTitleText" Text="Discover" FontSize="25" FontWeight="SemiBold" />
        <TextBlock x:Name="IntroText" Text="Search YouTube to find something to watch." Foreground="#69717D" />
      </StackPanel>
      <ListBox Grid.Row="1" x:Name="ResultsList" SelectionMode="Single" DoubleTapped="Results_OnDoubleTapped">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Padding="14,12" Margin="0,0,0,8" CornerRadius="6" Background="#F7F8FA">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Text="{Binding Metadata}" Foreground="#69717D" Margin="0,5,0,0" />
                <Button Grid.Column="1" Grid.RowSpan="2" Content="{Binding PlayLabel}" VerticalAlignment="Center" Click="PlayItem_OnClick" />
                <Button Grid.Column="2" Grid.RowSpan="2" Content="{Binding QueueLabel}" VerticalAlignment="Center" Margin="8,0,0,0" Click="QueueItem_OnClick" />
                <Button Grid.Column="3" Grid.RowSpan="2" Content="{Binding VideoDownloadLabel}" VerticalAlignment="Center" Margin="8,0,0,0" Click="DownloadItem_OnClick" />
                <Button Grid.Column="4" Grid.RowSpan="2" Content="{Binding AudioDownloadLabel}" VerticalAlignment="Center" Margin="8,0,0,0" Click="DownloadAudioItem_OnClick" />
                <Button Grid.Column="5" Grid.RowSpan="2" Content="{Binding SaveLabel}" VerticalAlignment="Center" Margin="8,0,0,0" Click="SaveItem_OnClick" />
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,12,0,12">
        <Button x:Name="PauseButton" Content="Pause / resume" Click="Pause_OnClick" />
        <Button x:Name="StopButton" Grid.Column="1" Content="Stop" Click="Stop_OnClick" />
        <Slider Grid.Column="2" x:Name="SeekSlider" Minimum="0" Maximum="1" VerticalAlignment="Center" PointerPressed="Seek_OnPointerPressed" PointerReleased="Seek_OnPointerReleased" />
        <TextBlock Grid.Column="3" x:Name="TimeText" Text="0:00 / 0:00" VerticalAlignment="Center" />
        <TextBlock x:Name="VolumeLabel" Grid.Column="4" Text="Volume" VerticalAlignment="Center" />
        <Slider Grid.Column="5" x:Name="VolumeSlider" Minimum="0" Maximum="130" Width="120" Value="100" VerticalAlignment="Center" ValueChanged="Volume_OnChanged" />
      </Grid>
      <Border Grid.Row="3" Padding="0,10,0,0" BorderThickness="0,1,0,0" BorderBrush="#D8DCE2">
        <TextBlock x:Name="StatusText" Text="Checking for yt-dlp and mpv…" Foreground="#69717D" />
      </Border>
    </Grid>
  </Grid>
</Window>
